#!/usr/bin/env bash
set -euo pipefail

AUTO_YES=0

while getopts ":yh" opt; do
    case "$opt" in
        y) AUTO_YES=1 ;;
        h) echo "Usage: update [-y]"; echo "  -y   Skip confirmation"; exit 0 ;;
        *) echo "x Unknown option: -$OPTARG" >&2; exit 1 ;;
    esac
done

if [[ "$AUTO_YES" -eq 0 ]]; then
    echo ""
    echo "  This will update all XBPS and Flatpak packages."
    echo ""
    echo "  ! Updates cannot be rolled back automatically."
    echo "  ! It is recommended to make a backup or snapshot first."
    echo ""
    read -rp "  Proceed? [y/N] " _reply
    case "${_reply,,}" in
        y|yes) ;;
        *) echo "  Aborted."; exit 0 ;;
    esac
fi

echo ""
echo "=== Sectly's Shell - System Update ==="
echo ""

echo "> Updating XBPS packages..."
xbps-install -Syu

echo ""
echo "> Updating Flatpak packages..."
flatpak update --noninteractive

echo ""
echo "+ System up to date"
