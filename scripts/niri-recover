#!/usr/bin/env bash

export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM=wayland
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export QT_PLUGIN_PATH=/usr/lib/qt6/plugins
export GDK_BACKEND=wayland
export SDL_VIDEODRIVER=wayland
export XDG_SESSION_TYPE=wayland
export CLUTTER_BACKEND=wayland
export _JAVA_AWT_WM_NONREPARENTING=1

uid=$(id -u)
export XDG_RUNTIME_DIR="/run/user/${uid}"
if [[ ! -d "$XDG_RUNTIME_DIR" ]]; then
    mkdir -p "$XDG_RUNTIME_DIR"
    chown "${uid}:${uid}" "$XDG_RUNTIME_DIR"
    chmod 700 "$XDG_RUNTIME_DIR"
fi

NIRI_BIN=$(command -v niri-session 2>/dev/null || command -v niri 2>/dev/null)
if [[ -z "$NIRI_BIN" ]]; then
    echo "niri not found in PATH"
    exit 1
fi

# Wait for system D-Bus socket - niri needs it for DisplayConfig/portals
echo "Waiting for D-Bus..."
for i in $(seq 1 20); do
    [[ -S /run/dbus/system_bus_socket ]] && break
    sleep 0.5
done
[[ -S /run/dbus/system_bus_socket ]] || echo "Warning: system D-Bus socket not found, niri may fail"

mkdir -p "$HOME/.local/state"

dbus-run-session "$NIRI_BIN" "$@"
exit_code=$?

if [[ $exit_code -ne 0 ]]; then
    export TERM=linux
    clear
    echo ""
    echo "  Niri exited with error code $exit_code."
    echo "  To restart niri:  $NIRI_BIN"
    echo "  To return to ly:  exit"
    echo ""
    exec bash --login
fi
